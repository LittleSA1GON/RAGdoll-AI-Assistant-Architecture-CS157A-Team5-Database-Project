<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>RAGdoll AI Assistant</display-name>

    <listener>
        <listener-class>application.MySqlCleanupListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>ApiServlet</servlet-name>
        <servlet-class>application.ApiServlet</servlet-class>
        <multipart-config>
            <max-file-size>26214400</max-file-size>
            <max-request-size>27262976</max-request-size>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>ApiServlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ApiServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>


    <filter>
        <filter-name>LocalQueryStartupFilter</filter-name>
        <filter-class>application.LocalQueryStartupFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>LocalQueryStartupFilter</filter-name>
        <url-pattern>/views/dashboard.jsp</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>LocalQueryStartupFilter</filter-name>
        <url-pattern>/views/admin.jsp</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>application.HomeServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>application.AuthServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

</web-app>